# FoodNutri Environment Configuration Template
# Copy this file to .env and fill in your values for local development.
# In production, set these variables in your hosting provider's dashboard.

# Flask Application Settings
SECRET_KEY=change_this_to_a_random_secure_secret_key
FLASK_DEBUG=False
PORT=5000

# Optional custom paths (defaults to local project directories)
# DATABASE_PATH=/var/data/database.db
# UPLOAD_FOLDER=/var/data/uploads

# SMTP Email Settings (for morning daily target & evening summary alerts)
FOODNUTRI_SMTP_HOST=smtp.gmail.com
FOODNUTRI_SMTP_PORT=587
FOODNUTRI_SMTP_USERNAME=your_email@gmail.com
FOODNUTRI_SMTP_PASSWORD=your_gmail_app_password
FOODNUTRI_FROM_EMAIL=your_email@gmail.com
